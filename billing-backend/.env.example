DATABASE_URL=postgresql://billing_app:pass@localhost:5432/billing_dev
PORT=8000
NODE_ENV=development

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run it twice — access and refresh secrets must be different values.
JWT_ACCESS_SECRET=replace-with-generated-secret
JWT_REFRESH_SECRET=replace-with-a-different-generated-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Directory where generated invoice/credit-note PDFs are written.
# Defaults to ./pdf-storage (relative to process.cwd()) if unset.
PDF_STORAGE_ROOT=./pdf-storage
